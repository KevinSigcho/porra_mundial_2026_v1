{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/fixtures.json", "/*.{css,js,ico,png,jpg,svg,webp}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
